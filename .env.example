# OpenRouter API key — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_key_here

# Dev only: stream a canned reading instead of calling OpenRouter.
# "1" = full reading, "error" = cut off halfway (demo the retry state).
# Or just run `npm run dev:mock`. Ignored in production builds.
# COSMIC_MOCK_READING=1
