# OpenRouter API key — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_key_here

# Stripe paywall — leave STRIPE_SECRET_KEY unset to keep the full reading free.
# Secret key: https://dashboard.stripe.com/apikeys (use sk_test_… locally)
STRIPE_SECRET_KEY=
# One-time Price for a full reading (price_…)
STRIPE_PRICE_ID=
# Shown on the unlock button; keep in sync with the Stripe Price
READING_PRICE_LABEL=$4.99
# Long random string, stable across deploys (binds payments to readings): openssl rand -hex 32
READING_HASH_SECRET=
# Public origin for Stripe return URLs (falls back to the request origin)
NEXT_PUBLIC_SITE_URL=
