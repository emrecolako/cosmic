# OpenRouter API key — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_key_here

# Stripe paywall — required in production. Locally, leave STRIPE_SECRET_KEY unset to unlock the full reading.
# Secret key: https://dashboard.stripe.com/apikeys (use sk_test_… locally)
STRIPE_SECRET_KEY=
# One-time Price for a full reading (price_…)
STRIPE_PRICE_ID=
# Shown on the unlock button; keep in sync with the Stripe Price
READING_PRICE_LABEL=\$4.99
# Long random string, stable across deploys (binds payments to readings): openssl rand -hex 32
READING_HASH_SECRET=
# Public origin for Stripe return URLs (falls back to the request origin)
NEXT_PUBLIC_SITE_URL=
# Signing secret of the Stripe webhook endpoint for /api/stripe-webhook (whsec_…).
# Subscribe it to checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# PostHog project key and host (browser + server-side order_paid capture)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional absolute ingestion host for server-side capture when NEXT_PUBLIC_POSTHOG_HOST is a relative proxy path
POSTHOG_HOST=
